# JD analysis uses the deterministic rule engine when no LLM key is configured.
# Set a server-only key to enable structured AI extraction with automatic fallback.
NEXT_PUBLIC_APP_NAME=JobProof
# Supabase v0.3 (public URL + publishable/anon key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only aliases are accepted for local scripts if needed.
SUPABASE_URL=
SUPABASE_ANON_KEY=
LLM_API_KEY=
# DeepSeek V4 Flash (OpenAI-compatible API)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Zhihu OAuth (server-side only; never commit real secrets)
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
ZHIHU_ACCESS_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
